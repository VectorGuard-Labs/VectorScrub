# PyHSM keystore backup. Runs on its own schedule and ALSO by hand after every `kms rotate`:
#   systemctl start vectorscrub-keystore-backup
[Unit]
Description=VectorScrub key service (PyHSM keystore) backup

[Service]
Type=oneshot
User=vsbackup
Group=vsbackup
# A different file from the database backup's: different GPG recipient, bucket and heartbeat.
EnvironmentFile=/etc/vectorscrub/keystore-backup.env
ExecStart=/opt/vectorscrub/infra/scripts/backup_keystore.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/vectorscrub-keystore
