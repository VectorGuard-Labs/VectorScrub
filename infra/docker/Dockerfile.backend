# Build stage
# The Rust version must be at least what the dependency set needs; 1.82 (the old pin) is too
# old for current crates. Bump deliberately, not by accident.
FROM rust:1.90-slim-bookworm AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

# Compile-time-checked queries (sqlx::query!) are verified against the checked-in .sqlx/
# metadata, so the image builds with NO database available. After changing any query!, run
# the "Regenerate" steps in the README and commit .sqlx/.
ENV SQLX_OFFLINE=true

COPY Cargo.toml Cargo.lock ./
COPY .sqlx ./.sqlx
COPY src ./src
COPY migrations ./migrations
RUN cargo build --release --locked

# Runtime stage
FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/vectorscrub ./vectorscrub
COPY --from=builder /app/migrations ./migrations
EXPOSE 8080
USER nobody
ENTRYPOINT ["./vectorscrub"]
