# ============================================================
# VectorScrub Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# THIS FILE IS FOR THE BACKEND AND DOCKER COMPOSE. The Python agents need their own, much
# smaller environment: BACKEND_API_URL, AGENT_API_KEY, REDIS_URL, the LLM keys, SMTP and DROP
# settings. They must NOT be given MASTER_ENCRYPTION_KEY, JWT_SECRET, DATABASE_URL or
# POSTGRES_PASSWORD, and refuse to start if they are (agents/shared/config.py). So do not copy
# this file to agents/.env, and do not start the agents from a directory whose .env is this file.
# ============================================================

# --- Database ---
DATABASE_URL=postgres://vectorscrub:changeme@localhost:5432/vectorscrub
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# --- Rust Backend ---
PORT=8080
ENVIRONMENT=development
DB_POOL_SIZE=10
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# --- Observability ---
# Optional OpenTelemetry OTLP endpoint for distributed tracing
# Example: http://localhost:4317 (Jaeger), https://api.honeycomb.io (Honeycomb)
# Leave empty to disable OTLP export
OTLP_ENDPOINT=

# Prometheus metrics are exposed at GET /api/v1/metrics
# No configuration needed - just scrape the endpoint

# JWT secret (>= 32 characters; the backend refuses to start otherwise)
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# AES-256-GCM master key (must decode to exactly 32 bytes) — generate with: openssl rand -base64 32
# This is the root key used to derive per-customer encryption keys.
# Treat it like a password to every customer's data.
MASTER_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# NOTE: the master key is read from this environment variable only. There is no HSM/KMS
# integration; in production inject it from your platform's secret manager.

# --- Rate limiting and login lockout (per client IP, in memory, per backend instance) ---
# Only set TRUST_PROXY_HEADERS=true when the backend sits behind a proxy that overwrites
# X-Forwarded-For / X-Real-IP. Otherwise clients could spoof their IP to dodge limits.
TRUST_PROXY_HEADERS=false
# How many of YOUR proxies are in front of the backend. The client address is the X-Forwarded-For
# entry this many places from the RIGHT (the left side is client-controlled). 1 = one nginx/ALB.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_GENERAL_PER_SECOND=20
RATE_LIMIT_GENERAL_BURST=60
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_AUTH_BURST=5

# --- Scan job recovery ---
SCAN_RECOVERY_INTERVAL_SECS=60
SCAN_STALE_AFTER_SECS=600
SCAN_REDISPATCH_AFTER_SECS=600
SCAN_MAX_ATTEMPTS=3

# --- Stripe billing (optional; leave STRIPE_WEBHOOK_SECRET unset to switch billing off) ---
# Backend only. Never put these in agents/.env: the agents refuse to start if they see the
# webhook secret. Use Stripe TEST mode keys/links until you go live.
# Signing secret of the webhook endpoint (Stripe Dashboard > Developers > Webhooks), whsec_...
# It also signs the customer reference in checkout links, so rotating it invalidates links
# opened before the change.
STRIPE_WEBHOOK_SECRET=
# The Stripe price id (price_...) behind each plan. A plan with no payment link is not offered.
# Comma-separated: the price currently SOLD first, then older prices that existing members still
# pay and that must keep their plan (the founding-member price lock), e.g.
#   STRIPE_PRICE_PERSONAL_MONTHLY=price_new,price_old
# Current launch: ONE monthly plan, Early Access at $4.99 (tier "personal"). Premium and annual
# are left unset on purpose. If annual is added later it is monthly x 10 (e.g. $49.90).
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
# The Payment Link (https://buy.stripe.com/...) that sells each plan. Set each link's
# "after payment" redirect to <your site>/dashboard/billing?checkout=success
STRIPE_LINK_PERSONAL_MONTHLY=
STRIPE_LINK_PERSONAL_ANNUAL=
STRIPE_LINK_PREMIUM_MONTHLY=
STRIPE_LINK_PREMIUM_ANNUAL=
# Customer Portal login link (Stripe Dashboard > Settings > Billing > Customer portal), where
# customers cancel, switch plan and update their card.
STRIPE_PORTAL_URL=

# --- Deletion requests emailed to companies for the customer (OFF by default) ---
# Lets paid customers authorize VectorScrub to email a deletion request to companies that publish a
# request address (data/broker_channels.json). Needs BOTH switches: this one on the backend, and
# DELETION_REQUESTS_SEND_ENABLED in the AGENT environment (plus working SMTP settings there). The
# authorization wording in services/deletion.rs is a DRAFT and must be reviewed by a privacy
# lawyer before either is turned on for real customers.
DELETION_REQUESTS_ENABLED=false

# --- Python Agent Layer ---
BACKEND_API_URL=http://localhost:8080

# Agent API key — cryptographically random key for internal service authentication
# (>= 32 characters). Generate with: openssl rand -base64 32
# This key is used by Python agents to authenticate with the Rust backend
AGENT_API_KEY=REPLACE_WITH_RANDOM_KEY_FROM_OPENSSL

# LLM provider (at least one required for detection)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# Default LLM provider: "openai" or "anthropic"
DEFAULT_LLM_PROVIDER=anthropic

# Default LLM model (provider-specific)
# Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# OpenAI: gpt-4o, gpt-4o-mini
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022

# --- SMTP Configuration (for email-based opt-out requests) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@vectorscrub.com
SMTP_USE_TLS=true

# --- California DROP API Configuration (UNUSED) ---
# No customer flow submits to DROP: no consumer-side API has been verified, so nothing reads
# these. Leave them alone. The dashboard links residents to the state's own site instead.
# DROP (Delete Request and Opt-Out Platform) - https://privacy.ca.gov/drop/
DROP_API_URL=https://privacy.ca.gov/api/v1
DROP_API_KEY=your-drop-api-key
DROP_API_SECRET=your-drop-api-secret
DROP_ENABLE_SANDBOX=true

# --- Frontend ---
# Where the Next.js server proxies /api/v1 (server-side only; never sent to browsers).
# Next.js bakes this in at BUILD time. In Docker it is the API_URL build argument in
# infra/docker/docker-compose.yml, not this variable.
API_URL=http://localhost:8080

# Shown on the Terms of Service and Privacy Policy pages as the address for support and data
# requests. Set it before inviting anyone: without it the pages show a visible placeholder.
CONTACT_EMAIL=you@example.com

# Pilot controls.
# Stop accepting new accounts at this many (blank = no limit). Keeps a pilot small; the check is
# not atomic, so a burst can overshoot by a few.
MAX_ACCOUNTS=
# Web server only: the one-time $1 pilot payment link shown on /pilot (https only), and whether
# to show the paid subscription on the home page (only when billing is really switched on).
PILOT_PAYMENT_URL=
SHOW_PAID_PLAN=false
