# ============================================================
# VectorScrub Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgres://vectorscrub:changeme@localhost:5432/vectorscrub
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# --- Rust Backend ---
PORT=8080
ENVIRONMENT=development
DB_POOL_SIZE=10
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# --- Observability ---
# Optional OpenTelemetry OTLP endpoint for distributed tracing
# Example: http://localhost:4317 (Jaeger), https://api.honeycomb.io (Honeycomb)
# Leave empty to disable OTLP export
OTLP_ENDPOINT=

# Prometheus metrics are exposed at GET /api/v1/metrics
# No configuration needed - just scrape the endpoint

# JWT secret — generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# === Option 1: Direct key (simpler, less secure) ===
# AES-256-GCM master key — generate with: openssl rand -base64 32
# This is the root key used to derive per-customer encryption keys.
# Treat it like a password to every customer's data.
MASTER_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# === Option 2: PyHSM (recommended for production) ===
# PyHSM provides hardware-backed key storage with automatic rotation
# If HSM_MASTER_PASSWORD is set, PyHSM will be used instead of MASTER_ENCRYPTION_KEY
# HSM_MASTER_PASSWORD=your-strong-password-here
# HSM_STORAGE_PATH=./keystore.enc  # Optional, defaults to ./keystore.enc

# --- Python Agent Layer ---
BACKEND_API_URL=http://localhost:8080

# Agent API key — cryptographically random key for internal service authentication
# Generate with: openssl rand -base64 32
# This key is used by Python agents to authenticate with the Rust backend
AGENT_API_KEY=REPLACE_WITH_RANDOM_KEY_FROM_OPENSSL

# LLM provider (at least one required for detection)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# Default LLM provider: "openai" or "anthropic"
DEFAULT_LLM_PROVIDER=anthropic

# Default LLM model (provider-specific)
# Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# OpenAI: gpt-4o, gpt-4o-mini
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022

# --- SMTP Configuration (for email-based opt-out requests) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@vectorscrub.com
SMTP_USE_TLS=true

# --- California DROP API Configuration ---
# DROP (Delete Request and Opt-Out Platform) - https://privacy.ca.gov/data-deletion/
DROP_API_URL=https://privacy.ca.gov/api/v1
DROP_API_KEY=your-drop-api-key
DROP_API_SECRET=your-drop-api-secret
DROP_ENABLE_SANDBOX=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
