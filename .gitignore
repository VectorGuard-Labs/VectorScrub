# Secrets — never commit
.env
.env.local
.env.*.local

# Rust
/backend/target/
# backend/Cargo.lock and backend/.sqlx/ are deliberately NOT ignored: the lockfile makes builds
# reproducible, and .sqlx/ lets the backend compile without a database (SQLX_OFFLINE=true).

# Python
__pycache__/
*.py[cod]
*.pyo
agents/.venv/
agents/venv/
agents/*.egg-info/
agents/dist/
agents/.pytest_cache/
.pytest_cache/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
